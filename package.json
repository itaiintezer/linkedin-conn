{
  "name": "linkedin-conn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs --stage=all",
    "update": "node scripts/update.mjs",
    "preinstall": "node scripts/preflight.mjs --stage=install",
    "postinstall": "node scripts/install-browser.mjs",
    "install-browser": "node scripts/install-browser.mjs",
    "prestart": "node scripts/preflight.mjs --stage=start",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "cloakbrowser": "0.4.5",
    "fastify": "^5.0.0",
    "playwright-core": "^1.61.1",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
